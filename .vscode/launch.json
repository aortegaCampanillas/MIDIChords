{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: MIDI Chords Analyzer",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "MIDICHORDS_FORCE_MIDI_OPEN": "1"
      }
    }
  ]
}
